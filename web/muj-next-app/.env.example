# Sablona: zkopiruj jako web/muj-next-app/.env.local a dopln hodnoty. Skutecny soubor do gitu nepatri.
PYTHON_API_URL=http://127.0.0.1:8000

# Databaze (lokalne z docker-compose; v Azure jde z Key Vaultu)
DATABASE_URL=postgresql://UZIVATEL:HESLO@localhost:5432/NAZEV_DB

# Adresa, na ktere appka bezi (pouziva se v odkazu v overovacim e-mailu)
APP_BASE_URL=http://localhost:3000

# E-maily: lokalne Mailpit (http://localhost:8025) bez prihlaseni
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Appka <no-reply@localhost>
# jen v Azure (SMTP s prihlasenim) - lokalne nech nevyplnene
SMTP_USER=
SMTP_PASSWORD=
